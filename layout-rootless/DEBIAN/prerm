#!/bin/sh
set -eu
case "${1:-}" in
 remove|deconfigure)
  # Rootless dependency alias is independently verified by the helper. The helper verifies ownership,
  # journal and target fingerprint. Never silently force removal on conflict.
  printf '%s\n' '{}' | /var/jb/usr/libexec/quiethosts-helper restore-for-uninstall || {
   echo 'QuietHosts: checked restore failed. Resolve the file conflict before uninstalling.' >&2
   exit 1
  }
  ;;
esac
